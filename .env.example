# Copie para .env e preencha. O .env nunca vai para o Git.

PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/zyra

# AWS: a mesma regiao serve o Cognito e o S3
AWS_REGION=us-east-2

# Cognito (autenticacao). O usuario IAM do back precisa de
# cognito-idp:AdminGetUser e cognito-idp:AdminDeleteUser no user pool, para
# recriar a conta de quem se cadastrou e nunca confirmou o codigo.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# S3 (fotos das roupas). O usuario IAM precisa de s3:PutObject, s3:GetObject
# e s3:DeleteObject no bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=zyra-roupas-tcc-435472314287-us-east-2-an

# Servico de visao, chamado no cadastro da peca (/analyze-clothing)
VISION_API_URL=http://localhost:8000

# OpenAI, usada pelo interpretador de pedidos do chat (src/looks)
OPENAI_API_KEY=
# Opcional (padrao: gpt-4.1-mini)
OPENAI_MODELO_INTERPRETACAO=

# Remetente dos avisos por e-mail (Amazon SES), ex.: ZYRA <seu-email@gmail.com>.
# O endereco precisa estar verificado no SES (mesma regiao do AWS_REGION) e o
# usuario IAM precisa de ses:SendEmail. Vazio: os avisos so vao para o log.
SES_REMETENTE=
