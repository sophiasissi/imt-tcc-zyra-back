// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Genero {
  MASCULINO
  FEMININO
  NAO_BINARIO
  PREFIRO_NAO_DIZER
  OUTRO
}

enum TipoDaltonismo {
  PROTANOMALIA
  PROTANOPIA
  DEUTERANOMALIA
  DEUTERANOPIA
  TRITANOMALIA
  TRITANOPIA
  ACROMATOPSIA
  NAO_SEI
  // Resposta "Nao tenho" do cadastro: a pessoa nao e' daltonica.
  NAO_TENHO
  PREFIRO_NAO_DIZER
}

// Valores da peca. Espelham src/clothing_analysis/taxonomy.py (visao) e
// src/looks/taxonomia.ts: os tres precisam ter exatamente os mesmos codigos.

enum Categoria {
  CAMISETA
  CAMISA
  MOLETOM
  JAQUETA
  BLAZER
  CALCA
  SHORT
  SAIA
  VESTIDO
  TENIS
  SAPATO
}

enum Estilo {
  CASUAL
  SOCIAL
  ESPORTIVO
  STREETWEAR
  ELEGANTE
  BASICO
}

enum Estampa {
  LISO
  ESTAMPADO
  LISTRADO
  XADREZ
  LOGO
}

enum Ocasiao {
  DIA_A_DIA
  TRABALHO
  FESTA
  ACADEMIA
  PRAIA
  CASA
}

enum Aquecimento {
  LEVE
  MEDIO
  QUENTE
}

enum Material {
  JEANS
  COURO
}

model Usuario {
  id String @id @default(uuid())

  cognitoSub String @unique

  nome  String?
  email String? @unique

  dataNascimento        DateTime?
  genero                Genero?
  tipoDaltonismo        TipoDaltonismo?
  nivelDificuldadeLooks Int?

  // Quando a pessoa autorizou guardar o tipo de daltonismo (dado de saude,
  // sensivel na LGPD). Null sem autorizacao ou depois de revoga-la.
  consentimentoSaudeEm DateTime?

  // Aceite dos Termos de uso no cadastro (checkbox da tela inicial do app).
  // A versao e' a data dos Termos aceitos, para saber quem aceitou qual texto
  // se eles mudarem.
  termosAceitosEm    DateTime?
  versaoTermosAceita String?

  pecas Peca[]
  looks Look[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Peca {
  id String @id @default(uuid())

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // Chave do objeto no S3, nao a URL. O bucket e privado (secao 11 do artigo)
  // e URL assinada expira -- guardar um link daria imagem quebrada depois. A
  // API devolve `imagemUrl`, uma URL assinada gerada na hora de exibir a peca.
  imagemS3Key String

  // Resultado da analise da peca pela OpenAI (/analyze-clothing). A categoria
  // e obrigatoria: sem ela a peca nao entra em looks e o cadastro e recusado.
  // O resto fica nulo quando a IA nao teve certeza; a pessoa corrige depois.
  categoria   Categoria
  estilo      Estilo?
  estampa     Estampa?
  ocasioes    Ocasiao[]    @default([])
  aquecimento Aquecimento?
  // So jeans e couro, os materiais que a IA reconhece com confianca pela foto.
  material    Material?

  // Resultado do /detect-color. E' o dado central do app: e' justamente o que
  // a pessoa daltonica nao consegue obter sozinha. O chat de looks compara as
  // cores pelo hex.
  corNome        String // "Azul Claro"
  hex            String // "#8FB3E0"
  colorAddSymbol String // "COLORADD_AZUL_CLARO"

  // Segunda cor de pecas listradas ou estampadas. A visao ainda nao preenche;
  // os campos ja existem para nao exigir outra migration quando preencher.
  corSecundariaNome        String?
  hexSecundario            String?
  colorAddSymbolSecundario String?

  looks LookPeca[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // O closet sempre lista as pecas de um usuario. Sem indice isso vira
  // varredura da tabela inteira conforme o numero de pecas cresce.
  @@index([usuarioId])
}

// Look salvo pelo usuario a partir do chat.
model Look {
  id String @id @default(uuid())

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  nome    String?
  ocasiao Ocasiao?

  pecas LookPeca[]

  criadoEm DateTime @default(now())

  @@index([usuarioId])
}

// Pecas de cada look, na ordem em que aparecem (cima, camada, baixo, calcado).
model LookPeca {
  lookId String
  look   Look   @relation(fields: [lookId], references: [id], onDelete: Cascade)

  pecaId String
  peca   Peca   @relation(fields: [pecaId], references: [id], onDelete: Cascade)

  ordem Int

  @@id([lookId, pecaId])
  @@index([pecaId])
}
